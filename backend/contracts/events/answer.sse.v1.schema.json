{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ragforge.local/events/answer.sse.v1.schema.json",
  "title": "RAGForge Answer SSE Event v1",
  "description": "Versioned answer stream event. Every event is space/correlation/run scoped, replayable by monotonically increasing sequence, and idempotent by event_id/idempotency_key.",
  "oneOf": [
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.delta"}, "payload": {"$ref": "#/$defs/deltaPayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.citation"}, "payload": {"$ref": "#/$defs/citationPayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.abstention"}, "payload": {"$ref": "#/$defs/abstentionPayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.tool"}, "payload": {"$ref": "#/$defs/toolPayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.usage"}, "payload": {"$ref": "#/$defs/usagePayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.error"}, "payload": {"$ref": "#/$defs/errorPayload"}}}]},
    {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "properties": {"event_type": {"const": "answer.done"}, "payload": {"$ref": "#/$defs/donePayload"}}}]}
  ],
  "$defs": {
    "uuidV7": {"type": "string", "format": "uuidv7", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "event_type", "sequence", "idempotency_key", "space_id", "correlation_id", "run_id", "occurred_at", "payload"],
      "properties": {
        "schema_version": {"type": "string", "const": "v1"},
        "event_id": {"$ref": "#/$defs/uuidV7"},
        "event_type": {"type": "string", "enum": ["answer.delta", "answer.citation", "answer.abstention", "answer.tool", "answer.usage", "answer.error", "answer.done"]},
        "sequence": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 255, "pattern": "^[A-Za-z0-9._:-]+$"},
        "space_id": {"$ref": "#/$defs/uuidV7"}, "correlation_id": {"$ref": "#/$defs/uuidV7"}, "run_id": {"$ref": "#/$defs/uuidV7"},
        "occurred_at": {"type": "string", "format": "date-time"}, "payload": {"type": "object"}
      }
    },
    "deltaPayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "delta"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "delta": {"type": "string", "minLength": 1, "maxLength": 10000}}},
    "citationPayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "claim_id", "citation"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "claim_id": {"$ref": "#/$defs/uuidV7"}, "citation": {"$ref": "../answer/citation.v1.schema.json"}}},
    "abstentionPayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "abstention"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "abstention": {"$ref": "../answer/abstention.v1.schema.json"}}},
    "toolPayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "tool_call_id", "tool_name", "status"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "tool_call_id": {"$ref": "#/$defs/uuidV7"}, "tool_name": {"type": "string", "enum": ["knowledge.search", "document.read", "web.fetch"]}, "status": {"type": "string", "enum": ["REQUESTED", "SUCCEEDED", "FAILED", "REJECTED", "TIMEOUT", "CANCELLED"]}}},
    "usagePayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "input_tokens", "output_tokens", "total_tokens", "tool_call_count", "estimated_cost_micros", "provider_reported"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "tool_call_count": {"type": "integer", "minimum": 0}, "estimated_cost_micros": {"type": ["integer", "null"], "minimum": 0}, "provider_reported": {"type": "boolean"}}},
    "errorPayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "code", "message", "retryable"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "code": {"type": "string", "enum": ["PROVIDER_UNAVAILABLE", "TIMEOUT", "SPACE_EGRESS_DENIED", "EVIDENCE_INVALID", "TOOL_FAILURE", "CANCELLED", "INTERNAL_ERROR"]}, "message": {"type": "string", "minLength": 1, "maxLength": 1000}, "retryable": {"type": "boolean"}}},
    "donePayload": {"type": "object", "additionalProperties": false, "required": ["answer_id", "status"], "properties": {"answer_id": {"$ref": "#/$defs/uuidV7"}, "status": {"type": "string", "enum": ["COMPLETED", "ABSTAINED", "FAILED", "CANCELLED"]}}}
  },
  "x-ragforge-replay": {"last_event_id": "client may reconnect with Last-Event-ID; server replays events with sequence greater than the acknowledged event", "sequence": "strictly increasing within a run", "event_id": "stable for a replayed event", "cancel": "after answer.done status CANCELLED, no later answer.delta is valid"},
  "x-ragforge-sensitive-fields-denied": ["password", "secret", "api_key", "access_token", "credential_ref", "authorization", "cookie", "prompt", "system_prompt", "full_text", "raw_text", "document_content"]
}
