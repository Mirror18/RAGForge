# Copy the required values into a local .env file or pass them with --env-file.
# These are development placeholders only; never use them for shared environments.
COMPOSE_PROJECT_NAME=ragforge-p1-local
RAGFORGE_NETWORK_NAME=ragforge-p1-local-core
RAGFORGE_VOLUME_PREFIX=ragforge-p1-local

POSTGRES_PORT=25432
QDRANT_PORT=26333
QDRANT_GRPC_PORT=26334
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=25673
VALKEY_PORT=26379
S3_PORT=29000
S3_CONSOLE_PORT=29001
APP_GATEWAY_PORT=25080
WEB_PORT=25174

POSTGRES_DB=ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change-me
QDRANT_API_KEY=change-me
RABBITMQ_DEFAULT_USER=ragforge
RABBITMQ_DEFAULT_PASS=change-me
VALKEY_PASSWORD=change-me
S3_ACCESS_KEY=ragforge
S3_SECRET_KEY=change-me-minio-secret

# Chat and embedding use space-authorized OpenAI-compatible cloud APIs.
# There is no Ollama product path and no silent cloud failover.

# Optional app profile (builds from deploy/docker/Dockerfile):
# Local development uses :local defaults. Shared/deploy environments must set
# all four values to name@sha256:<immutable-digest> references.
# RAGFORGE_SERVER_IMAGE=registry.example/ragforge/server@sha256:<immutable-digest>
# RAGFORGE_GATEWAY_IMAGE=registry.example/ragforge/gateway@sha256:<immutable-digest>
# RAGFORGE_WORKER_IMAGE=registry.example/ragforge/ingestion-worker@sha256:<immutable-digest>
# RAGFORGE_WEB_IMAGE=registry.example/ragforge/web@sha256:<immutable-digest>
