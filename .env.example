# Copy to .env for local development. Never commit real credentials.
RAGFORGE_ENV=local
RAGFORGE_PUBLIC_URL=http://localhost:8080

POSTGRES_DB=ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=change-me
QDRANT_API_KEY=change-me
RABBITMQ_DEFAULT_USER=ragforge
RABBITMQ_DEFAULT_PASS=change-me
VALKEY_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com
# Local-only secret reference; put the real value in .env.local, never in Git.
XIAOMI_API_KEY=
# Local-only path; the directory contents stay outside Git and are selected by the web UI.
RAGFORGE_LOCAL_NOTES_ROOT=
# Comma-separated public host allowlist for web knowledge sources; empty means deny all.
RAGFORGE_WEB_SOURCE_ALLOWED_HOSTS=
